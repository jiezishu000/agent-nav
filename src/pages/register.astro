---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="注册 - Agent Nav">
  <div style="max-width:440px;margin:40px auto;">
    <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
      <h1 style="font-size:22px;font-weight:700;margin-bottom:4px;">创建账号</h1>
      <p style="font-size:13px;color:var(--text-dim);margin-bottom:24px;">注册后可提交 Agent、收藏和管理</p>

      <form id="register-form" style="display:flex;flex-direction:column;gap:16px;">
        <div>
          <label style="display:block;font-size:12px;font-weight:600;margin-bottom:4px;color:var(--text-dim);">邮箱</label>
          <input type="email" id="reg-email" required
            style="width:100%;padding:10px 14px;border-radius:var(--radius-sm);border:1px solid var(--border);background:var(--bg);color:var(--text);font-size:13px;outline:none;"
            onfocus="this.style.borderColor='var(--blue)'" onblur="this.style.borderColor=''" />
        </div>
        <div>
          <label style="display:block;font-size:12px;font-weight:600;margin-bottom:4px;color:var(--text-dim);">密码</label>
          <input type="password" id="reg-password" required minlength="8"
            style="width:100%;padding:10px 14px;border-radius:var(--radius-sm);border:1px solid var(--border);background:var(--bg);color:var(--text);font-size:13px;outline:none;"
            onfocus="this.style.borderColor='var(--blue)'" onblur="this.style.borderColor=''" />
        </div>
        <div>
          <label style="display:block;font-size:12px;font-weight:600;margin-bottom:4px;color:var(--text-dim);">邀请码（选填）</label>
          <input type="text" id="reg-invite"
            style="width:100%;padding:10px 14px;border-radius:var(--radius-sm);border:1px solid var(--border);background:var(--bg);color:var(--text);font-size:13px;outline:none;"
            onfocus="this.style.borderColor='var(--blue)'" onblur="this.style.borderColor=''" />
        </div>
        <button type="submit"
          style="padding:10px;border-radius:var(--radius-sm);border:none;background:var(--blue);color:#fff;font-size:14px;font-weight:600;cursor:pointer;">
          注册
        </button>
      </form>

      <p style="margin-top:16px;font-size:12px;color:var(--text-dim);text-align:center;">
        已有账号？<a href="/login" style="color:var(--blue);">立即登录</a>
      </p>
      <p style="margin-top:8px;font-size:11px;color:var(--text-muted);text-align:center;">
        注册即表示同意 <a href="/about" style="color:var(--blue);">服务条款</a>
      </p>

      <div id="reg-msg" style="display:none;margin-top:16px;padding:10px;border-radius:var(--radius-sm);font-size:12px;"></div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('register-form');
  const msgEl = document.getElementById('reg-msg');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('reg-email') as HTMLInputElement).value;
    const password = (document.getElementById('reg-password') as HTMLInputElement).value;
    const inviteCode = (document.getElementById('reg-invite') as HTMLInputElement).value;
    try {
      const res = await fetch('http://localhost:8000/api/v1/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });
      if (res.ok) {
        msgEl!.style.display = 'block';
        msgEl!.style.background = 'rgba(63,185,80,0.1)';
        msgEl!.style.color = 'var(--green)';
        msgEl!.textContent = '注册成功！即将跳转到登录页...';
        setTimeout(() => { window.location.href = '/login'; }, 1500);
      } else {
        const err = await res.json();
        msgEl!.style.display = 'block';
        msgEl!.style.background = 'rgba(248,81,73,0.1)';
        msgEl!.style.color = 'var(--red)';
        msgEl!.textContent = err.detail?.[0]?.msg || err.detail || '注册失败，请重试';
      }
    } catch {
      msgEl!.style.display = 'block';
      msgEl!.style.background = 'rgba(248,81,73,0.1)';
      msgEl!.style.color = 'var(--red)';
      msgEl!.textContent = '无法连接服务器，请确保后端已启动';
    }
  });
</script>
